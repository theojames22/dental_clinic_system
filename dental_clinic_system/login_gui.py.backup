    def _fp_send_code(self):
        import random
        # Generate DB code
        self.verification_code = f"{random.randint(100000, 999999)}"
        self.db.save_reset_code(self.recovery_username, self.verification_code)
        
        method_txt = "email address" if self.selected_recovery_method == "email" else "phone number"
        self.code_subtitle.setText(f"We've sent a 6-digit code to your registered {method_txt}.")
        
        for le in self.otp_inputs:
            le.clear()
        
        # Start resend timer
        self.resend_seconds = 30
        self.resend_btn.setDisabled(True)
        self.resend_btn.setText(f"Resend Code ({self.resend_seconds}s)")
        self.resend_timer.start(1000)
        
        from PyQt6.QtWidgets import QMessageBox
        QMessageBox.information(self, "Verification Code", 
            f"Demo Mode: Your verification code is: {self.verification_code}")
            
        self.forgot_pw_stacked_widget.setCurrentIndex(2)
        self.otp_inputs[0].setFocus()

    def _update_resend_timer(self):
        self.resend_seconds -= 1
        if self.resend_seconds <= 0:
            self.resend_timer.stop()
            self.resend_btn.setText("Resend Code")
            self.resend_btn.setDisabled(False)
        else:
            self.resend_btn.setText(f"Resend Code ({self.resend_seconds}s)")

    def _fp_verify_code(self):
        code = "".join([le.text() for le in self.otp_inputs])
        if len(code) != 6 or not code.isdigit():
            self.show_error_notification("Please enter a valid 6-digit code")
            return
            
        if self.db.validate_reset_code(self.recovery_username, code):
            self.show_success_notification("Code verified successfully!")
            self.resend_timer.stop()
            self.forgot_pw_stacked_widget.setCurrentIndex(3)
        else:
            self.show_error_notification("Invalid or expired verification code")

    def _fp_do_reset(self):
        new_pw = self.fp_new_pw_entry["edit"].text()
        conf_pw = self.fp_conf_pw_entry["edit"].text()
        
        if not new_pw or not conf_pw:
            self.show_error_notification("Please fill in all fields")
            return
        if new_pw != conf_pw:
            self.show_error_notification("Passwords do not match")
            return
        if len(new_pw) < 8:
            self.show_error_notification("Password must be at least 8 characters")
            return
            
        success = self.db.update_user_password_by_username(self.recovery_username, new_pw)
        if success:
            self.db.clear_reset_code(self.recovery_username)
            self.show_success_notification("Password reset successfully!")
            from PyQt6.QtCore import QTimer
            QTimer.singleShot(1500, self.show)
        else:
            self.show_error_notification("Failed to reset password. Please try again.")

