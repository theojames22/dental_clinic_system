    def _fp_verify_username(self):
        username = self.recovery_username_entry["edit"].text().strip()
        if not username:
            self.show_error_notification("Please enter your username")
            return
        if not self.db.check_username_exists(username):
            self.show_error_notification("Username not found")
            return
            
        self.recovery_username = username
        self.selected_recovery_method = None
        self.fp_send_code_btn.setDisabled(True)
        
        # clear previous
        while self.recovery_method_container.count():
            item = self.recovery_method_container.takeAt(0)
            if item.widget():
                item.widget().deleteLater()
                
        user = self.db.get_user_by_username(username)
        email = user.get('email') if user else None
        phone = self.db.get_user_phone(username)
        
        self.recovery_method_buttons = []
        
        if email:
            masked_email = self._mask_email(email)
            self._add_recovery_method_btn("email", "Recovery via Email", masked_email, "RECOMMENDED", "📧")
        if phone:
            masked_phone = self._mask_phone(phone)
            self._add_recovery_method_btn("sms", "Recovery via SMS", masked_phone, "", "📱")
            
        if not email and not phone:
            lbl = QLabel("No recovery methods available for this account. Please contact administrator.")
            lbl.setStyleSheet("color:#DC3545;font-size:14px;background:transparent;")
            self.recovery_method_container.addWidget(lbl)
            
        self.forgot_pw_stacked_widget.setCurrentIndex(1)
        
    def _mask_email(self, email):
        if not email or "@" not in email: return email
        parts = email.split("@")
        name = parts[0]
        if len(name) > 2:
            name = name[:2] + "*" * (len(name) - 2)
        return f"{name}@{parts[1]}"
        
    def _mask_phone(self, phone):
        if not phone: return phone
        if len(phone) > 4:
            return f"{phone[:3]}***{phone[-2:]}"
        return phone
        
    def _add_recovery_method_btn(self, method_id, title, desc, tag, icon):
        btn = QPushButton()
        btn.setFixedHeight(80)
        from PyQt6.QtCore import Qt
        btn.setCursor(Qt.CursorShape.PointingHandCursor)
        
        layout = QHBoxLayout(btn)
        layout.setContentsMargins(15, 10, 15, 10)
        
        icon_lbl = QLabel(icon)
        icon_lbl.setStyleSheet("font-size:24px;background:transparent;")
        layout.addWidget(icon_lbl)
        
        text_layout = QVBoxLayout()
        if tag:
            tag_lbl = QLabel(tag)
            tag_lbl.setStyleSheet("color:#10B981;font-size:10px;font-weight:bold;background:transparent;")
            text_layout.addWidget(tag_lbl)
        
        t_lbl = QLabel(title)
        t_lbl.setStyleSheet("color:#1F2937;font-size:14px;font-weight:700;background:transparent;")
        text_layout.addWidget(t_lbl)
        
        d_lbl = QLabel(desc)
        d_lbl.setStyleSheet("color:#6B7280;font-size:12px;background:transparent;")
        text_layout.addWidget(d_lbl)
        
        layout.addLayout(text_layout)
        layout.addStretch()
        
        radio = QRadioButton()
        radio.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)
        layout.addWidget(radio)
        
        btn.setStyleSheet("""
            QPushButton {
                background:white;
                border:1px solid #E5E7EB;
                border-radius:10px;
                text-align: left;
            }
            QPushButton:hover {
                border:1px solid #0b76ef;
                background:#F3F4F6;
            }
        """)
        
        self.recovery_method_container.addWidget(btn)
        
        info = {"button": btn, "radio": radio, "method": method_id}
        self.recovery_method_buttons.append(info)
        
        btn.clicked.connect(lambda: self._select_method(info))
        
    def _select_method(self, info):
        self.selected_recovery_method = info["method"]
        self.fp_send_code_btn.setDisabled(False)
        for item in self.recovery_method_buttons:
            item["radio"].setChecked(item == info)
            if item == info:
                item["button"].setStyleSheet("""
                    QPushButton {
                        background:#EFF6FF;
                        border:2px solid #0b76ef;
                        border-radius:10px;
                        text-align: left;
                    }
                """)
            else:
                item["button"].setStyleSheet("""
                    QPushButton {
                        background:white;
                        border:1px solid #E5E7EB;
                        border-radius:10px;
                        text-align: left;
                    }
                    QPushButton:hover {
                        border:1px solid #0b76ef;
                        background:#F3F4F6;
                    }
                """)

    def _setup_fp_page_code(self):
        page = QWidget()
