        from PyQt6.QtCore import Qt
        title = QLabel("Enter Recovery Code")
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        title.setStyleSheet("color:#1F2937;font-size:32px;font-weight:700;background:transparent;")
        content.addWidget(title)
        content.addSpacing(12)
        
        self.code_subtitle = QLabel("We've sent a 6-digit code to your registered email address.")
        self.code_subtitle.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.code_subtitle.setWordWrap(True)
        self.code_subtitle.setStyleSheet("color:#6B7280;font-size:14px;background:transparent;")
        content.addWidget(self.code_subtitle)
        content.addSpacing(35)
        
        # OTP Boxes
        otp_layout = QHBoxLayout()
        otp_layout.setSpacing(10)
        otp_layout.setAlignment(Qt.AlignmentFlag.AlignCenter)
        
        self.otp_inputs = []
        for i in range(6):
            le = QLineEdit()
            le.setFixedSize(50, 60)
            le.setMaxLength(1)
            le.setAlignment(Qt.AlignmentFlag.AlignCenter)
            le.setStyleSheet("""
                QLineEdit {
                    background:#F3F4F6;
                    border:1px solid #E5E7EB;
                    border-radius:10px;
                    font-size:24px;
                    font-weight:700;
                    color:#1F2937;
                }
                QLineEdit:focus { border:2px solid #1E3A8A; background:white; }
            """)
            le.textChanged.connect(lambda text, idx=i: self._on_otp_change(text, idx))
            otp_layout.addWidget(le)
            self.otp_inputs.append(le)
            
        content.addLayout(otp_layout)
        content.addSpacing(30)
        
        self.fp_verify_btn = QPushButton("Verify Code →")
        self.fp_verify_btn.setFixedHeight(52)
        self.fp_verify_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self.fp_verify_btn.setStyleSheet("""
            QPushButton {
                background-color:#1E3A8A;
                color:white;
                font-size:15px;
                font-weight:700;
                border-radius:10px;
                border: none;
            }
            QPushButton:hover { background-color:#1E40AF; }
        """)
        self.fp_verify_btn.clicked.connect(self._fp_verify_code)
        content.addWidget(self.fp_verify_btn)
        content.addSpacing(20)
        
        resend_layout = QHBoxLayout()
        resend_layout.addStretch()
        resend_lbl = QLabel("Didn't receive the code?")
        resend_lbl.setStyleSheet("color:#6B7280;font-size:13px;background:transparent;")
        resend_layout.addWidget(resend_lbl)
        
        self.resend_btn = QPushButton("Resend Code")
        self.resend_btn.setFlat(True)
        self.resend_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self.resend_btn.setStyleSheet("""
            QPushButton {
                color:#10B981;
                font-size:13px;
                font-weight:700;
                border:none;
                background:transparent;
            }
            QPushButton:hover { color:#059669; }
            QPushButton:disabled { color:#9CA3AF; }
        """)
        self.resend_btn.clicked.connect(self._fp_send_code)
        resend_layout.addWidget(self.resend_btn)
        resend_layout.addStretch()
        content.addLayout(resend_layout)
        
        content.addStretch()
        
        back_row = QHBoxLayout()
        back_row.addStretch()
        back_btn = QPushButton("← Back")
        back_btn.setFlat(True)
        back_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        back_btn.setStyleSheet("""
            QPushButton {
                color:#0b76ef;
                font-size:13px;
                font-weight:700;
                border:none;
                background:transparent;
            }
            QPushButton:hover { color:#1E3A8A; }
        """)
        back_btn.clicked.connect(lambda: self.forgot_pw_stacked_widget.setCurrentIndex(1))
        back_row.addWidget(back_btn)
        back_row.addStretch()
        content.addLayout(back_row)
        
        self.forgot_pw_stacked_widget.addWidget(page)
        
        from PyQt6.QtCore import QTimer
        self.resend_timer = QTimer(self)
        self.resend_timer.timeout.connect(self._update_resend_timer)
        self.resend_seconds = 0

    def _on_otp_change(self, text, idx):
        if text and idx < 5:
            self.otp_inputs[idx+1].setFocus()
        elif not text and idx > 0:
            self.otp_inputs[idx-1].setFocus()

